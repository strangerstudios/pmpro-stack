<?xml version="1.0" encoding="UTF-8"?>
<!--
  pmpro-stack hardened ImageMagick security policy.

  Replaces Ubuntu's stock /etc/ImageMagick-6/policy.xml, which leaves every
  coder and delegate enabled.

  Why: distribution packages can lag upstream security releases. This policy
  reduces exposure to historically exploited surfaces - external
  delegates (Ghostscript for PDF/PS/EPS), script-style coders (MSL, MVG,
  SVG), and indirect path reads - and allows only the raster formats
  WordPress actually needs.

  Consequences by design:
  - PDF thumbnails are NOT generated by Imagick anymore; this role installs
    poppler-utils so PDF previews can be rasterized with pdftoppm instead.
  - HEIC (iPhone) uploads, WebP/AVIF generation, and all normal media
    editing keep working.

  Evaluation order matters: policy entries are read top to bottom and the
  LAST matching entry wins, so the deny-all lines come first and the
  format allowlist follows.

  Resource limits below mirror Ubuntu's stock values (no behavior change
  for legitimate images).
-->
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)*>
<!ATTLIST policymap xmlns CDATA #FIXED "">
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED "">
<!ATTLIST policy domain NMTOKEN #REQUIRED>
<!ATTLIST policy name NMTOKEN #IMPLIED>
<!ATTLIST policy pattern CDATA #IMPLIED>
<!ATTLIST policy rights NMTOKEN #IMPLIED>
<!ATTLIST policy stealth NMTOKEN #IMPLIED>
<!ATTLIST policy value CDATA #IMPLIED>
]>
<policymap>
  <policy domain="Undefined" rights="none"/>

  <!-- Ubuntu stock resource limits, kept verbatim. -->
  <policy domain="resource" name="memory" value="1024MiB"/>
  <policy domain="resource" name="map" value="2048MiB"/>
  <policy domain="resource" name="area" value="256MP"/>
  <policy domain="resource" name="disk" value="2GiB"/>
  <policy domain="resource" name="width" value="32KP"/>
  <policy domain="resource" name="height" value="32KP"/>

  <!-- No external delegates: kills Ghostscript (PDF/PS/EPS), video, and
       URL-fetch conversion paths. -->
  <policy domain="delegate" rights="none" pattern="*"/>

  <!-- No process-to-process filters. -->
  <policy domain="filter" rights="none" pattern="*"/>

  <!-- Deny every coder, then allow back the raster formats WordPress
       needs. JPG/JPE/HEIF/TIF spellings included in case rights are
       checked against the format name rather than the owning module. The
       HEIC module registers AVIF/HEIC/HEIF together, so the family shares
       one rights tier. TIFF/ICO need write too: core treats both as
       editable images and saves their subsizes in the source format, so
       read-only would silently break their thumbnails (TIFF encoding is
       maintained libtiff from main; ICO is a trivial raster container). -->
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{GIF,JPEG,JPG,JPE,PNG,WEBP,AVIF,HEIC,HEIF,BMP,TIFF,TIF,ICO}"/>

  <!-- Belt and braces for the script-style module family (coder policy
       has had historical bypasses). -->
  <policy domain="module" rights="none" pattern="{MSL,MVG,PS,PS2,PS3,EPS,PDF,XPS,SVG,URL,TEXT,TXT,LABEL,CAPTION}"/>

  <!-- No indirect reads (@/path/file) or stdin. -->
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="path" rights="none" pattern="-"/>
</policymap>
