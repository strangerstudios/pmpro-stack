#!/bin/bash
# Maintains the Apache deny list fail2ban bans into.
#
# Packet-level bans (iptables/nftables) match the packet source, which on a
# Cloudflare-proxied site is a Cloudflare edge IP, never the attacker. Apache
# sees the real client via mod_remoteip, so the ban has to land here.
#
# Every HTTP jail shares this one deny list, and their bantimes differ by up to
# a week, so entries are reference-counted per jail: an IP stays denied until
# the LAST jail holding it unbans. Storing bare IPs would let the shortest ban
# expiring drop a deny that longer jails still want.
#
# List format, one record per line: <jail><TAB><ip>
#
# Usage: pmpro-f2b-apache-deny <add|del|clear|flush|render> [jail] [ip]

set -euo pipefail

# Overridable so the render path can be exercised in tests.
LIST=${PMPRO_F2B_LIST:-/var/lib/fail2ban/pmpro-apache-deny.list}
CONF=${PMPRO_F2B_CONF:-/etc/apache2/conf-available/pmpro-f2b-deny.conf}
LINK=${PMPRO_F2B_LINK:-/etc/apache2/conf-enabled/pmpro-f2b-deny.conf}
LOCK=${PMPRO_F2B_LOCK:-/var/lock/pmpro-f2b-apache-deny.lock}
RELOAD=${PMPRO_F2B_RELOAD:-1}
RELOAD_DELAY=${PMPRO_F2B_RELOAD_DELAY:-1}
PENDING="${LIST}.reload-pending"
RELOAD_LOCK="${LOCK}.reload"

# Distinct IPs still referenced by at least one jail.
active_ips() {
	[[ -s "$LIST" ]] || return 0
	cut -f2 "$LIST" | grep -v '^$' | sort -u
}

build_conf() {
	echo "# Managed by fail2ban (pmpro-apache-deny). Do not edit by hand."
	echo "# Regenerate: pmpro-f2b-apache-deny render"
	echo
	# Location is applied after Directory in Apache's merge order, so a
	# Directory-scoped block at a shallower path would be silently inert.
	#
	# AuthMerging And is load-bearing: without it (AuthMerging defaults to Off)
	# this last-evaluated Location REPLACES the authorization of every earlier
	# context, so its "Require all granted" would override the "Require all
	# denied" in .htaccess files (member-file protection, for one) and
	# <Files ~ "^\.ht">, serving those files to any non-banned visitor. "And"
	# combines this ban list WITH those denies instead of replacing them: a
	# denied resource stays denied, a granted one stays granted for non-banned
	# IPs, and banned IPs are still refused everywhere.
	echo '<Location "/">'
	echo "  AuthMerging And"
	echo "  <RequireAll>"
	echo "    Require all granted"
	active_ips | while read -r ip; do
		echo "    Require not ip $ip"
	done
	echo "  </RequireAll>"
	echo "</Location>"
}

# Apache must pick up a new list, but a fail2ban start or stop replays one
# ban per ticket. Queue the reload and let a single detached worker coalesce
# the burst into one graceful reload, retrying if a reload fails.
queue_reload() {
	[[ "$RELOAD" == "1" ]] || return 0
	touch "$PENDING"
	# 9>&- so the worker never holds the list lock while it waits.
	setsid "$0" _reload-worker </dev/null >/dev/null 2>&1 9>&- &
}

reload_worker() {
	local failures=0
	while :; do
		exec 8>"$RELOAD_LOCK"
		flock -n 8 || exit 0
		while [[ -f "$PENDING" ]]; do
			sleep "$RELOAD_DELAY"
			rm -f "$PENDING"
			# try-: a stopped Apache (boot, shutdown) is not a failure.
			if ! systemctl try-reload-or-restart apache2; then
				failures=$((failures + 1))
				logger -t pmpro-f2b-apache-deny "apache2 reload failed (attempt ${failures})" || true
				[[ $failures -ge 5 ]] && exit 1
				touch "$PENDING"
				sleep 5
			fi
		done
		flock -u 8
		exec 8>&-
		# A ban queued between the drain and the unlock lost the flock race.
		[[ -f "$PENDING" ]] || exit 0
	done
}

render() {
	local tmp backup fresh=0
	tmp=$(mktemp "${CONF}.XXXXXX")
	build_conf > "$tmp"
	chmod 0644 "$tmp"

	if [[ -f "$CONF" ]] && cmp -s "$tmp" "$CONF"; then
		rm -f "$tmp"
		# A reload that failed earlier still owes Apache this list.
		[[ -f "$PENDING" ]] && queue_reload
		return 0
	fi

	# Keep the outgoing conf so a failed configtest can be rolled back. Leaving
	# a broken file in place would arm any *other* reload trigger (an ansible
	# handler, a cron, an operator) to take every vhost on the box down.
	backup=""
	if [[ -f "$CONF" ]]; then
		backup=$(mktemp "${CONF}.bak.XXXXXX")
		cat "$CONF" > "$backup"
	else
		fresh=1
	fi

	mv -f "$tmp" "$CONF"
	# Enable on first render only, so a deliberate a2disconf sticks.
	[[ $fresh -eq 1 && ! -e "$LINK" ]] && ln -sf "../conf-available/$(basename "$CONF")" "$LINK"

	if apache2ctl configtest >/dev/null 2>&1; then
		[[ -n "$backup" ]] && rm -f "$backup"
		queue_reload
		return 0
	fi

	echo "pmpro-f2b-apache-deny: configtest failed, rolling back" >&2
	apache2ctl configtest >&2 || true
	if [[ -n "$backup" ]]; then
		mv -f "$backup" "$CONF"
	else
		rm -f "$CONF"
		[[ -L "$LINK" ]] && rm -f "$LINK"
	fi
	return 1
}

# Rewrite the list through a filter, atomically.
rewrite() {
	local tmp
	tmp=$(mktemp "${LIST}.XXXXXX")
	"$@" < "$LIST" > "$tmp" || true
	mv -f "$tmp" "$LIST"
}

# An IPv4/IPv6 address or CIDR. Anything else would fail configtest on every
# later render and silently block all future bans.
valid_ip() {
	[[ "$1" =~ ^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$ && "$1" =~ [.:] ]]
}

main() {
	touch "$LIST"

	case "${1:-}" in
		add)
			local rec
			if ! valid_ip "${3:-}"; then
				echo "pmpro-f2b-apache-deny: refusing non-IP ban target '${3:-}'" >&2
				exit 2
			fi
			printf -v rec '%s\t%s' "$2" "$3"
			grep -qxF "$rec" "$LIST" || printf '%s\n' "$rec" >> "$LIST"
			render
			;;
		del)
			local rec
			printf -v rec '%s\t%s' "$2" "$3"
			rewrite grep -vxF "$rec"
			render
			;;
		clear)
			# Drop every record for one jail, leaving other jails' bans intact.
			rewrite grep -vP "^$(printf '%s' "$2" | sed 's/[][\.*^$(){}?+|/]/\\&/g')\t"
			render
			;;
		flush)
			: > "$LIST"
			render
			;;
		render)
			render
			;;
		*)
			echo "usage: $0 <add|del|clear> <jail> [ip] | <flush|render>" >&2
			exit 2
			;;
	esac
}

if [[ "${1:-}" == "_reload-worker" ]]; then
	reload_worker
	exit 0
fi

mkdir -p "$(dirname "$LIST")" "$(dirname "$LOCK")"
exec 9>"$LOCK"
flock 9
main "$@"
