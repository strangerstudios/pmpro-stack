[DEFAULT]
bantime = 3600
findtime = 1800
maxretry = 15
# auto = file-based polling. The Apache jails (here and the canonical
# WordPress jails in jail.d/) watch log FILES; a systemd default would make
# their logpath directives inert. sshd overrides to systemd below (noble has
# no auth.log without rsyslog).
backend = auto
banaction = iptables-multiport
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
backend = systemd
port = ssh
maxretry = 5

[apache-auth]
enabled = true
port = http,https
logpath = /var/log/apache2/*error.log
maxretry = 5

# Vhost logs use <domain>_access.log / <domain>-access.log / access.log,
# so all access-log jails glob *access.log (matches all three schemes).
[apache-badbots]
enabled = true
port = http,https
logpath = /var/log/apache2/*access.log

[apache-noscript]
enabled = true
port = http,https
logpath = /var/log/apache2/*error.log
