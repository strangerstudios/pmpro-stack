#!/usr/bin/env bash
#
# pmpro-stack — Provision a hardened WordPress + Paid Memberships Pro server
#               from scratch on DigitalOcean, configured live with Ansible.
#
# One command, stock Ubuntu 24.04, no golden image:
#
#   pmpro-stack create --domain members.example.com --le-email you@example.com
#
# This:
#   1. create-droplet — boot a stock ubuntu-24-04-x64 droplet on DigitalOcean.
#   2. setup-dns      — upsert apex + www A records in YOUR Cloudflare zone.
#   3. configure      — run the bundled Ansible playbook (../ansible/site.yml)
#                       against the fresh droplet: hardened LAMP + Redis +
#                       PHP-FPM stack + Let's Encrypt TLS via certbot.
#   4. install-wp     — create the DB, download WordPress + PMPro (+ Memberlite),
#                       write wp-config.php, run `wp core install`, install wp-cron.
#
# Subcommands can also be run individually (see `pmpro-stack --help`).
#
# Requires: curl, jq, ssh, scp, openssl (always); ansible-playbook (for
# `configure`/`create`); dig (best-effort DNS wait in `create`).
#
# Tokens: DO_API_TOKEN and CF_API_TOKEN from the environment, or sourced from
# ~/.pmpro-stack.env (KEY=value lines).
#

set -euo pipefail

# ─── Script / repo location ──────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="$REPO_ROOT/ansible"

# ─── Defaults ────────────────────────────────────────────────────────────────
DEFAULT_REGION="nyc3"
DEFAULT_SIZE="s-2vcpu-4gb"
DEFAULT_TAG="pmpro-stack"
DEFAULT_TITLE="Membership Site"
DEFAULT_ADMIN_USER="admin"
DOCROOT="/var/www/vhosts/staging/public"
SSH_WAIT_TIMEOUT=180
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR"

ENV_FILE="${HOME}/.pmpro-stack.env"
PROVISION_IP_FILE="${PROVISION_IP_FILE:-/dev/null}"

# ─── Pretty output ─────────────────────────────────────────────────────────────
die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "→ $*"; }
bold() { printf '\033[1m%s\033[0m' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠ %s\033[0m\n' "$*"; }

# ─── Dependency checks ─────────────────────────────────────────────────────────
require_cmds() {
	local missing=()
	local c
	for c in "$@"; do
		command -v "$c" >/dev/null 2>&1 || missing+=("$c")
	done
	if [[ ${#missing[@]} -gt 0 ]]; then
		echo "ERROR: Missing required command(s): ${missing[*]}" >&2
		echo "" >&2
		for c in "${missing[@]}"; do
			case "$c" in
				ansible|ansible-playbook|ansible-galaxy)
					echo "  ${c}: pipx install --include-deps ansible   (recommended)" >&2
					echo "       or: pip3 install ansible --break-system-packages   (PEP-668 hosts)" >&2
					echo "       or: sudo apt-get install -y ansible" >&2
					;;
				jq|curl|openssl|tar) echo "  ${c}: sudo apt-get install -y ${c}" >&2 ;;
				ssh|scp|ssh-keygen)  echo "  ${c}: sudo apt-get install -y openssh-client" >&2 ;;
				dig)                 echo "  ${c}: sudo apt-get install -y dnsutils" >&2 ;;
				*)                   echo "  ${c}: install via your package manager" >&2 ;;
			esac
		done
		exit 1
	fi
}

# ─── Env loading ───────────────────────────────────────────────────────────────
trim_ws() {
	local v="$1"
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	printf '%s' "$v"
}

load_env_file() {
	local envfile="$1"
	[[ -f "$envfile" ]] || return 0
	set +e +u; set -a
	# shellcheck source=/dev/null
	source "$envfile"
	local rc=$?
	set +a; set -e -u
	[[ "$rc" -eq 0 ]] || die "Failed to parse ${envfile}."
}

load_env() {
	load_env_file "$ENV_FILE"

	# Normalize tokens (strip CR + surrounding whitespace).
	if [[ -n "${DO_API_TOKEN:-}" ]]; then
		DO_API_TOKEN="${DO_API_TOKEN//$'\r'/}"
		DO_API_TOKEN="$(trim_ws "$DO_API_TOKEN")"
	fi
	if [[ -n "${CF_API_TOKEN:-}" ]]; then
		CF_API_TOKEN="${CF_API_TOKEN//$'\r'/}"
		CF_API_TOKEN="$(trim_ws "$CF_API_TOKEN")"
	fi

	[[ -n "${DO_API_TOKEN:-}" ]] || die "DO_API_TOKEN not set (export it or put it in ${ENV_FILE})."
	[[ -n "${CF_API_TOKEN:-}" ]] || die "CF_API_TOKEN not set (export it or put it in ${ENV_FILE})."
}

# ─── API helpers ───────────────────────────────────────────────────────────────
do_api() {
	local method="$1" endpoint="$2"
	shift 2
	local url="https://api.digitalocean.com/v2${endpoint}"
	local response
	response=$(curl -s -X "$method" -H "Authorization: Bearer ${DO_API_TOKEN}" \
		-H "Content-Type: application/json" "$@" "$url")

	# Check for API errors
	local err_id
	err_id=$(echo "$response" | jq -r '.id // empty' 2>/dev/null || true)
	if [[ -n "$err_id" && "$err_id" != "null" ]]; then
		local err_msg
		err_msg=$(echo "$response" | jq -r '.message // "Unknown error"' 2>/dev/null)
		die "DO API error: ${err_msg} (${err_id})"
	fi
	echo "$response"
}

cf_api() {
	local method="$1" endpoint="$2"
	shift 2
	local url="https://api.cloudflare.com/client/v4${endpoint}"
	local response
	response=$(curl -s -X "$method" -H "Authorization: Bearer ${CF_API_TOKEN}" \
		-H "Content-Type: application/json" "$@" "$url")

	local success
	success=$(echo "$response" | jq -r '.success' 2>/dev/null || echo "false")
	if [[ "$success" != "true" ]]; then
		local errors
		errors=$(echo "$response" | jq -r '.errors[]?.message // "Unknown error"' 2>/dev/null)
		die "CF API error: ${errors}"
	fi
	echo "$response"
}

gen_password() {
	openssl rand -base64 16 | tr -d '=+/' | cut -c1-16
}

# ─── SSH helpers ───────────────────────────────────────────────────────────────
wait_for_ssh() {
	local ip="$1"
	local elapsed=0
	info "Waiting for SSH on ${ip}..."
	# shellcheck disable=SC2086
	while [[ $elapsed -lt $SSH_WAIT_TIMEOUT ]]; do
		if ssh ${SSH_OPTS} "root@${ip}" "echo ok" >/dev/null 2>&1; then
			ok "SSH is ready"
			return 0
		fi
		sleep 5
		elapsed=$((elapsed + 5))
	done
	die "SSH not ready after ${SSH_WAIT_TIMEOUT}s on ${ip}"
}

ssh_cmd() {
	local ip="$1"
	shift
	# shellcheck disable=SC2086
	ssh ${SSH_OPTS} "root@${ip}" "$@"
}

# ─── Cloudflare zone resolution ────────────────────────────────────────────────
# Resolve the Cloudflare zone ID for a domain by walking up the labels until a
# matching active zone is found in the token's account.
cf_zone_for_domain() {
	local domain="$1"
	domain=$(echo "$domain" | sed -E 's|^https?://||; s|/.*||')

	local parts="$domain"
	while [[ "$parts" == *.* ]]; do
		local response
		response=$(curl -s -X GET \
			-H "Authorization: Bearer ${CF_API_TOKEN}" \
			-H "Content-Type: application/json" \
			"https://api.cloudflare.com/client/v4/zones?name=${parts}&status=active")

		local zone_id
		zone_id=$(echo "$response" | jq -r '.result[0].id // empty' 2>/dev/null)
		if [[ -n "$zone_id" ]]; then
			echo "$zone_id"
			return 0
		fi

		# Strip first label: foo.example.com → example.com
		parts="${parts#*.}"
	done

	die "No Cloudflare zone found for ${domain}. Add the domain to Cloudflare first."
}

# Upsert a single A record (create if missing, patch if present) in a zone.
cf_upsert_a_record() {
	local zone_id="$1" name="$2" ip="$3" proxied="$4"

	local records_response
	records_response=$(curl -s -X GET \
		-H "Authorization: Bearer ${CF_API_TOKEN}" \
		-H "Content-Type: application/json" \
		"https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?type=A&name=${name}")

	local record_id
	record_id=$(echo "$records_response" | jq -r --arg n "$name" '.result[] | select(.name == $n) | .id' | head -1)

	local payload
	payload=$(jq -n \
		--arg type "A" \
		--arg name "$name" \
		--arg content "$ip" \
		--argjson proxied "$proxied" \
		--arg ttl "1" \
		'{type: $type, name: $name, content: $content, proxied: $proxied, ttl: ($ttl | tonumber)}')

	if [[ -n "$record_id" ]]; then
		info "Updating A record ${name} → ${ip} (proxied: ${proxied})..."
		cf_api PATCH "/zones/${zone_id}/dns_records/${record_id}" -d "$payload" >/dev/null
		ok "Updated ${name} → ${ip}"
	else
		info "Creating A record ${name} → ${ip} (proxied: ${proxied})..."
		cf_api POST "/zones/${zone_id}/dns_records" -d "$payload" >/dev/null
		ok "Created ${name} → ${ip}"
	fi
}

# Resolve whether to manage a www.<domain> alias, honoring an explicit override.
# Default is no www (apex or subdomain). When proxied, Cloudflare Universal SSL
# doesn't cover a multi-level www anyway, and a bare www adds little. Pass --www
# to opt in (only sensible for apex domains, where CF covers *.example.com).
resolve_include_www() {
	local mode="$2"  # $1 (domain) retained in the call signature, not needed now
	case "$mode" in
		yes) echo true ;;
		*)   echo false ;;
	esac
}

# ─── DigitalOcean SSH key resolution ───────────────────────────────────────────
# Resolve a DO SSH key id from a public key file, importing it idempotently.
# Echoes the numeric key id on stdout.
do_resolve_ssh_key_from_file() {
	local pubkey_file="$1"
	[[ -f "$pubkey_file" ]] || die "SSH public key file not found: ${pubkey_file}"

	# Compute the MD5 fingerprint DO uses for /account/keys.
	local fingerprint
	fingerprint=$(ssh-keygen -lf "$pubkey_file" -E md5 2>/dev/null | awk '{print $2}' | sed 's/^MD5://')
	[[ -n "$fingerprint" ]] || die "Could not compute fingerprint for ${pubkey_file}."

	# Look for an existing matching key on the account.
	local keys_response existing_id
	keys_response=$(do_api GET "/account/keys?per_page=200")
	existing_id=$(echo "$keys_response" | jq -r --arg fp "$fingerprint" \
		'.ssh_keys[] | select(.fingerprint == $fp) | .id' | head -1)
	if [[ -n "$existing_id" && "$existing_id" != "null" ]]; then
		echo "$existing_id"
		return 0
	fi

	# Import it.
	local pubkey_content payload import_response new_id
	pubkey_content=$(trim_ws "$(cat "$pubkey_file")")
	payload=$(jq -n \
		--arg name "pmpro-stack-$(date +%Y%m%d%H%M%S)" \
		--arg public_key "$pubkey_content" \
		'{name: $name, public_key: $public_key}')
	import_response=$(do_api POST "/account/keys" -d "$payload")
	new_id=$(echo "$import_response" | jq -r '.ssh_key.id // empty')
	[[ -n "$new_id" && "$new_id" != "null" ]] || die "Failed to import SSH key to DigitalOcean."
	echo "$new_id"
}

# Resolve the SSH key id to use at create time. Sets the global RESOLVED_SSH_KEY_ID.
# Order: explicit --ssh-key-id, then --ssh-key-file, then auto-detect a local pubkey.
resolve_ssh_key_id() {
	local key_id="$1" key_file="$2"

	if [[ -n "$key_id" ]]; then
		[[ "$key_id" =~ ^[0-9]+$ ]] || die "--ssh-key-id must be numeric (got '${key_id}')."
		RESOLVED_SSH_KEY_ID="$key_id"
		return 0
	fi

	if [[ -n "$key_file" ]]; then
		RESOLVED_SSH_KEY_ID="$(do_resolve_ssh_key_from_file "$key_file")"
		return 0
	fi

	# Auto-detect a local public key.
	local candidate
	for candidate in "${HOME}/.ssh/id_ed25519.pub" "${HOME}/.ssh/id_rsa.pub"; do
		if [[ -f "$candidate" ]]; then
			info "Using SSH key ${candidate}"
			RESOLVED_SSH_KEY_ID="$(do_resolve_ssh_key_from_file "$candidate")"
			return 0
		fi
	done

	die "No SSH key resolved. Pass --ssh-key-id <id> or --ssh-key-file <pubkey>, or create ~/.ssh/id_ed25519.pub."
}

# ─── Commands ────────────────────────────────────────────────────────────────
# Destroy a droplet create-droplet made but could not bring up. Checks the HTTP
# status directly: do_api treats a transport failure or non-JSON 5xx as success.
rollback_droplet() {
	local id="$1" code
	warn "Bring-up failed; destroying droplet ${id} so it is not left running (and billing)..."
	code=$(curl --disable \
		--config <(printf 'header = "Authorization: Bearer %s"\n' "$DO_API_TOKEN") \
		-s -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 \
		-X DELETE "https://api.digitalocean.com/v2/droplets/${id}") || code="000"
	if [[ "$code" == "204" || "$code" == "404" ]]; then
		warn "Destroyed droplet ${id}."
	else
		warn "Could not destroy droplet ${id} (HTTP ${code}). Delete it in the DigitalOcean dashboard."
	fi
}

cmd_create_droplet() {
	local domain="" region="$DEFAULT_REGION" size="$DEFAULT_SIZE"
	local ssh_key_id="" ssh_key_file="" backups=false

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--domain)        domain="$2"; shift 2 ;;
			--region)        region="$2"; shift 2 ;;
			--size)          size="$2"; shift 2 ;;
			--ssh-key-id)    ssh_key_id="$2"; shift 2 ;;
			--ssh-key-file)  ssh_key_file="$2"; shift 2 ;;
			--backups)       backups=true; shift ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$domain" ]] || die "Missing --domain"
	require_cmds curl jq ssh openssl ssh-keygen
	load_env

	# Resolve the SSH key id (import a pubkey to DO if needed).
	resolve_ssh_key_id "$ssh_key_id" "$ssh_key_file"

	info "Creating droplet '${domain}' (${size}, ${region}, ubuntu-24-04-x64)..."

	local tags_json
	tags_json=$(jq -n '["pmpro-stack"]')

	local payload
	payload=$(jq -n \
		--arg name "$domain" \
		--arg region "$region" \
		--arg size "$size" \
		--arg image "ubuntu-24-04-x64" \
		--argjson ssh_keys "[${RESOLVED_SSH_KEY_ID}]" \
		--argjson backups "$backups" \
		--argjson monitoring false \
		--argjson tags "$tags_json" \
		'{
			name: $name,
			region: $region,
			size: $size,
			image: $image,
			ssh_keys: $ssh_keys,
			backups: $backups,
			monitoring: $monitoring,
			tags: $tags
		}')

	local response
	response=$(do_api POST "/droplets" -d "$payload")

	local droplet_id
	droplet_id=$(echo "$response" | jq -r '.droplet.id')
	[[ "$droplet_id" =~ ^[0-9]+$ ]] || die "Failed to create droplet. Response: $response"

	info "Droplet created (ID: ${droplet_id}). Waiting for it to become active with a public IP..."

	# Until bring-up succeeds, an interrupt destroys the droplet so a retry
	# never leaves the first one orphaned.
	trap "rollback_droplet '${droplet_id}'; exit 130" INT
	trap "rollback_droplet '${droplet_id}'; exit 143" TERM

	# DO can report active before the public IPv4 is attached, so wait for both.
	# Transient API errors are retried; the wall-clock deadline and per-request
	# timeouts keep the poll near 5 minutes.
	local status="new" ip="" poll deadline=$((SECONDS + 300))
	while [[ ( "$status" != "active" || -z "$ip" ) && $SECONDS -lt $deadline ]]; do
		sleep 5
		poll=$(do_api GET "/droplets/${droplet_id}" --connect-timeout 10 --max-time 20 2>/dev/null) || poll=""
		status=$(echo "$poll" | jq -r '.droplet.status // "unknown"' 2>/dev/null) || status="unknown"
		ip=$(echo "$poll" | jq -r '.droplet.networks.v4[]? | select(.type == "public") | .ip_address' 2>/dev/null | head -1) || ip=""
	done

	if [[ "$status" != "active" ]]; then
		rollback_droplet "$droplet_id"
		die "Droplet not active after 5 minutes. Status: ${status}"
	fi
	if [[ -z "$ip" ]]; then
		rollback_droplet "$droplet_id"
		die "Could not get public IP for droplet ${droplet_id}"
	fi
	trap - INT TERM

	ok "Droplet active: ${domain} → ${ip} (ID: ${droplet_id})"

	# Echo the IP for `create` to capture.
	echo "$ip" > "$PROVISION_IP_FILE"

	echo ""
	echo "$(bold 'Droplet ID:')  ${droplet_id}"
	echo "$(bold 'Domain:')      ${domain}"
	echo "$(bold 'IP:')          ${ip}"
	echo "$(bold 'Region:')      ${region}"
	echo "$(bold 'Size:')        ${size}"
	echo "$(bold 'SSH:')         ssh root@${ip}"
}

cmd_setup_dns() {
	local domain="" ip="" proxied=false www_mode="auto"

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--domain)    domain="$2"; shift 2 ;;
			--ip)        ip="$2"; shift 2 ;;
			--cf-proxy)  proxied=true; shift ;;
			--www)       www_mode="yes"; shift ;;
			--no-www)    www_mode="no"; shift ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$domain" ]] || die "Missing --domain"
	[[ -n "$ip" ]]     || die "Missing --ip"
	require_cmds curl jq
	load_env

	domain=$(echo "$domain" | sed -E 's|^https?://||; s|/.*||')

	info "Looking up Cloudflare zone for ${domain}..."
	local zone_id
	zone_id=$(cf_zone_for_domain "$domain")
	ok "Found zone: ${zone_id}"

	cf_upsert_a_record "$zone_id" "$domain" "$ip" "$proxied"

	local include_www
	include_www=$(resolve_include_www "$domain" "$www_mode")
	if [[ "$include_www" == true ]]; then
		cf_upsert_a_record "$zone_id" "www.${domain}" "$ip" "$proxied"
		ok "DNS pointed: ${domain} (+ www) → ${ip} (proxied: ${proxied})"
	else
		info "Skipping www.${domain} (no www by default; pass --www to include it)."
		ok "DNS pointed: ${domain} → ${ip} (proxied: ${proxied})"
	fi
}

cmd_configure() {
	local ip="" domain="" le_email="" open_firewall=false www_mode="auto"
	local smtp_relayhost="" smtp_user="" smtp_pass=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--ip)              ip="$2"; shift 2 ;;
			--domain)          domain="$2"; shift 2 ;;
			--le-email)        le_email="$2"; shift 2 ;;
			--smtp-relayhost)  smtp_relayhost="$2"; shift 2 ;;
			--smtp-user)       smtp_user="$2"; shift 2 ;;
			--smtp-pass)       smtp_pass="$2"; shift 2 ;;
			--open-firewall)   open_firewall=true; shift ;;
			--www)             www_mode="yes"; shift ;;
			--no-www)          www_mode="no"; shift ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$ip" ]]     || die "Missing --ip"
	[[ -n "$domain" ]] || die "Missing --domain"
	require_cmds ssh ansible-playbook
	[[ -f "$ANSIBLE_DIR/site.yml" ]] || die "Ansible playbook not found at ${ANSIBLE_DIR}/site.yml"

	# Step 1: wait for the fresh droplet's SSH to come up.
	wait_for_ssh "$ip"

	# Step 2: install required Ansible collections (best-effort).
	if [[ -f "$ANSIBLE_DIR/requirements.yml" ]]; then
		info "Installing Ansible collection requirements..."
		ansible-galaxy collection install -r "$ANSIBLE_DIR/requirements.yml" \
			|| warn "ansible-galaxy collection install failed — continuing (collections may already be present)."
	fi

	# Step 3: write a temporary inventory pointing at the droplet.
	local tmpinv
	tmpinv=$(mktemp /tmp/pmpro-stack-inv.XXXXXX)
	# Bake the literal path in: a RETURN trap fires again when the *caller*
	# returns, by which point $tmpinv is out of scope and `set -u` would abort.
	# shellcheck disable=SC2064  # expand-now is intentional here
	trap "rm -f -- '$tmpinv'" RETURN
	cat > "$tmpinv" <<-INV
		[webserver]
		${ip} ansible_user=root ansible_ssh_common_args='${SSH_OPTS}'
	INV

	# Step 4: build extra-vars (only pass what was provided; always server_name).
	local extra_vars="server_name=${domain}"
	[[ -n "$le_email" ]]       && extra_vars+=" letsencrypt_email=${le_email}"
	[[ -n "$smtp_relayhost" ]] && extra_vars+=" smtp_relayhost=${smtp_relayhost} smtp_relayport=587"
	[[ -n "$smtp_user" ]]      && extra_vars+=" smtp_user=${smtp_user}"
	[[ -n "$smtp_pass" ]]      && extra_vars+=" smtp_pass=${smtp_pass}"
	[[ "$open_firewall" == true ]] && extra_vars+=" restrict_http_to_cloudflare=false"
	extra_vars+=" include_www=$(resolve_include_www "$domain" "$www_mode")"

	if [[ -z "$le_email" ]]; then
		warn "No --le-email given: certbot is skipped, the site will be HTTP-only until you issue a cert."
	fi

	info "Running Ansible playbook against ${ip} (this takes several minutes)..."
	ansible-playbook -i "$tmpinv" "$ANSIBLE_DIR/site.yml" --extra-vars "$extra_vars" \
		|| die "Ansible playbook failed. Inspect the output above, fix, and re-run: pmpro-stack configure --ip ${ip} --domain ${domain}"

	ok "Server configured: ${domain} (${ip})"
}

cmd_install_wp() {
	local ip="" domain="" title="$DEFAULT_TITLE"
	local admin_user="$DEFAULT_ADMIN_USER" admin_email="" admin_pass=""
	local creds_file="" no_creds_file=false

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--ip)           ip="$2"; shift 2 ;;
			--domain)       domain="$2"; shift 2 ;;
			--title)        title="$2"; shift 2 ;;
			--admin-user)   admin_user="$2"; shift 2 ;;
			--admin-email)  admin_email="$2"; shift 2 ;;
			--admin-pass)   admin_pass="$2"; shift 2 ;;
			--creds-file)   creds_file="$2"; shift 2 ;;
			--no-creds-file) no_creds_file=true; shift ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$ip" ]]     || die "Missing --ip"
	[[ -n "$domain" ]] || die "Missing --domain"
	require_cmds ssh openssl tar

	local url="https://${domain}"
	[[ -n "$admin_email" ]] || admin_email="admin@${domain}"
	[[ -n "$admin_pass" ]]  || admin_pass=$(gen_password)

	info "Installing WordPress on ${ip}..."
	wait_for_ssh "$ip"

	# Step 1: wait for MySQL, then create DB + user + password on the server.
	info "Waiting for MySQL..."
	local mysql_tries=0
	while ! ssh_cmd "$ip" "mysqladmin ping" >/dev/null 2>&1; do
		mysql_tries=$((mysql_tries + 1))
		if [[ $mysql_tries -ge 30 ]]; then
			die "MySQL did not start within 30 seconds"
		fi
		sleep 1
	done
	ok "MySQL is ready"

	info "Setting up MySQL database..."
	local db_output
	db_output=$(ssh_cmd "$ip" "bash -s" <<-'DBSETUP'
		set -euo pipefail
		db_name="db_$(openssl rand -hex 3)"
		db_user="user_$(openssl rand -hex 3)"
		db_pass="$(openssl rand -hex 12)"

		if [[ ! -f /root/wp-db.txt ]]; then
			printf 'DB_PASSWORD=%s\nDB_NAME=%s\nDB_USER=%s\n' \
				"$db_pass" "$db_name" "$db_user" > /root/wp-db.txt
			chmod 600 /root/wp-db.txt
		else
			source /root/wp-db.txt
			db_name="$DB_NAME"
			db_user="$DB_USER"
			db_pass="$DB_PASSWORD"
		fi

		mysql -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
		mysql -e "CREATE USER IF NOT EXISTS '${db_user}'@'%' IDENTIFIED BY '${db_pass}';"
		mysql -e "GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'%';"
		mysql -e "FLUSH PRIVILEGES;"

		echo "PROVISION_DB_NAME=${db_name}"
		echo "PROVISION_DB_USER=${db_user}"
		echo "PROVISION_DB_PASS=${db_pass}"
	DBSETUP
	)

	local db_name db_user db_pass
	db_name=$(echo "$db_output" | grep '^PROVISION_DB_NAME=' | cut -d= -f2)
	db_user=$(echo "$db_output" | grep '^PROVISION_DB_USER=' | cut -d= -f2)
	db_pass=$(echo "$db_output" | grep '^PROVISION_DB_PASS=' | cut -d= -f2)

	[[ -n "$db_name" ]] || die "Failed to get DB name from server"
	[[ -n "$db_user" ]] || die "Failed to get DB user from server"
	[[ -n "$db_pass" ]] || die "Failed to get DB password from server"

	ok "MySQL database created"

	# Step 2: download WordPress core + PMPro + Memberlite from public URLs.
	# The Ansible base/ssl roles already created the docroot and own the vhost.
	info "Downloading WordPress core + plugins + themes..."
	ssh_cmd "$ip" "DOCROOT='${DOCROOT}' bash -s" <<-'DOWNLOAD'
		set -euo pipefail
		cd /tmp
		rm -rf wp-stack-build
		mkdir -p wp-stack-build
		cd wp-stack-build

		echo "Downloading WordPress..."
		curl -sL -o wp.zip "https://wordpress.org/latest.zip"
		unzip -q wp.zip
		# Move core into the docroot without clobbering the Ansible-placed wp-cli.yml.
		cp -a wordpress/. "${DOCROOT}/"
		rm -rf wordpress wp.zip

		cd "${DOCROOT}"

		echo "Downloading Paid Memberships Pro..."
		curl -sL -o /tmp/pmpro.zip "https://www.paidmembershipspro.com/wp-content/uploads/plugins/paid-memberships-pro.zip"
		unzip -q /tmp/pmpro.zip -d wp-content/plugins/

		echo "Downloading PMPro Update Manager..."
		curl -sL -o /tmp/pmpro-um.zip "https://www.paidmembershipspro.com/wp-content/uploads/plugins/pmpro-update-manager.zip"
		unzip -q /tmp/pmpro-um.zip -d wp-content/plugins/

		echo "Downloading Memberlite theme..."
		if curl -fsSL -o /tmp/memberlite.zip "https://www.paidmembershipspro.com/wp-content/uploads/plugins/memberlite.zip"; then
			unzip -q /tmp/memberlite.zip -d wp-content/themes/
		else
			echo "WARN: Memberlite theme download failed; keeping default theme." >&2
		fi

		echo "Downloading Memberlite Child theme..."
		if curl -fsSL -o /tmp/memberlite-child.zip "https://www.paidmembershipspro.com/downloads/memberlite-child.zip"; then
			unzip -q /tmp/memberlite-child.zip -d wp-content/themes/
		else
			echo "WARN: Memberlite Child theme download failed." >&2
		fi

		rm -rf wp-content/plugins/akismet wp-content/plugins/hello.php
		mkdir -p wp-content/mu-plugins
		rm -f /tmp/pmpro.zip /tmp/pmpro-um.zip /tmp/memberlite.zip /tmp/memberlite-child.zip
		echo "Downloads complete."
	DOWNLOAD
	ok "WordPress files installed"

	# Step 3: configure + install WordPress as the pmpro user.
	info "Configuring WordPress..."
	ssh_cmd "$ip" "DOCROOT='${DOCROOT}' WP_URL='${url}' WP_TITLE='${title}' WP_ADMIN_USER='${admin_user}' WP_ADMIN_EMAIL='${admin_email}' WP_ADMIN_PASS='${admin_pass}' bash -s" <<-'CONFIGURE'
		set -euo pipefail
		cd "${DOCROOT}"

		# Read DB credentials written during DB setup.
		source /root/wp-db.txt

		# Core files were copied as root; hand the docroot to pmpro so WP-CLI
		# (run as pmpro below) can write wp-config.php and the rest.
		chown -R pmpro:pmpro "${DOCROOT}"

		run_wp() { sudo -u pmpro -H WP_CLI_ALLOW_ROOT=0 wp --path="${DOCROOT}" "$@"; }

		run_wp config create \
			--dbname="${DB_NAME}" \
			--dbuser="${DB_USER}" \
			--dbpass="${DB_PASSWORD}" \
			--dbhost="localhost" \
			--dbcharset="utf8mb4" \
			--dbprefix="wp_" \
			--force \
			--extra-php <<-'EXTRA_PHP'
		// Honor Cloudflare's X-Forwarded-Proto so an HTTP-to-origin hop (no origin cert yet, or SSL mode Flexible) doesn't loop on redirects.
		if ( isset( $_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === $_SERVER['HTTP_X_FORWARDED_PROTO'] ) { $_SERVER['HTTPS'] = 'on'; }
		EXTRA_PHP

		rm -f wp-config-sample.php

		# Hardening + Redis object cache constants.
		run_wp config set DISALLOW_FILE_EDIT true --raw --type=constant
		run_wp config set FS_METHOD "'direct'" --raw --type=constant
		run_wp config set FORCE_SSL_ADMIN true --raw --type=constant
		run_wp config set DISABLE_WP_CRON true --raw --type=constant
		run_wp config set WP_POST_REVISIONS 10 --raw --type=constant
		run_wp config set WP_MEMORY_LIMIT "'256M'" --raw --type=constant
		run_wp config set WP_MAX_MEMORY_LIMIT "'1024M'" --raw --type=constant
		run_wp config set WP_ENVIRONMENT_TYPE "'production'" --raw --type=constant
		run_wp config set WP_CACHE true --raw --type=constant
		run_wp config set WP_REDIS_HOST "'127.0.0.1'" --raw --type=constant
		run_wp config set WP_REDIS_PORT 6379 --raw --type=constant
		run_wp config set WP_REDIS_MAXTTL "'3600'" --raw --type=constant
		run_wp config set WP_REDIS_CLIENT "'phpredis'" --raw --type=constant
		run_wp config set WP_REDIS_PREFIX "'pmpro_stack_'" --raw --type=constant
		run_wp config set WP_REDIS_GRACEFUL true --raw --type=constant

		run_wp core install \
			--url="${WP_URL}" \
			--title="${WP_TITLE}" \
			--admin_user="${WP_ADMIN_USER}" \
			--admin_email="${WP_ADMIN_EMAIL}" \
			--admin_password="${WP_ADMIN_PASS}" \
			--skip-email

		# Activate the child theme if it installed; otherwise the parent.
		if [[ -d "wp-content/themes/memberlite-child" ]]; then
			run_wp theme activate memberlite-child || true
		elif [[ -d "wp-content/themes/memberlite" ]]; then
			run_wp theme activate memberlite || true
		fi

		run_wp plugin activate paid-memberships-pro pmpro-update-manager || true

		run_wp option update timezone_string 'America/New_York'
		run_wp rewrite structure '/%postname%/'
		run_wp rewrite flush

		# Ownership: docroot belongs to the pmpro user.
		chown -R pmpro:pmpro "${DOCROOT}"
		find "${DOCROOT}" -type d -exec chmod 755 {} +
		find "${DOCROOT}" -type f -exec chmod 644 {} +

		# WP-CLI cron as the pmpro user (DISABLE_WP_CRON is set above). Never run
		# wp-cron from root's crontab: root-owned cron creates uploads/YYYY/MM as
		# root at month rollover and breaks PHP-FPM uploads.
		cat > /etc/cron.d/pmpro-wp-cron <<-CRON
			# WordPress cron for pmpro-stack — runs as the pmpro user every 5 minutes.
			*/5 * * * * pmpro /usr/local/bin/wp --path=${DOCROOT} cron event run --due-now >/dev/null 2>&1
		CRON
		chmod 644 /etc/cron.d/pmpro-wp-cron

		echo "WordPress configured."
	CONFIGURE
	ok "WordPress installed and configured"

	# Step 4: deploy the PMPro Stack caching MU plugin + activate the dropins.
	local mu_src="$REPO_ROOT/mu-plugin"
	if [[ -f "$mu_src/pmpro-stack.php" && -d "$mu_src/pmpro-stack" ]]; then
		info "Deploying PMPro Stack caching MU plugin..."
		# shellcheck disable=SC2086
		tar czf - -C "$mu_src" pmpro-stack.php pmpro-stack \
			| ssh ${SSH_OPTS} "root@${ip}" "set -e; mkdir -p '${DOCROOT}/wp-content/mu-plugins' && tar xzf - -C '${DOCROOT}/wp-content/mu-plugins' && chown -R pmpro:pmpro '${DOCROOT}/wp-content/mu-plugins'"

		# Install the object-cache.php + advanced-cache.php dropins now (as pmpro)
		# so caching is live immediately, not on the first wp-admin visit.
		ssh_cmd "$ip" "DOCROOT='${DOCROOT}' bash -s" <<-'MUACT'
			set -euo pipefail
			cat > /tmp/pmpro-stack-activate.php <<'PHP'
			<?php
			$c = new PMPro_Stack_Cache();
			echo $c->install_object_cache_dropin() ? "object-cache.php installed\n" : "object-cache.php: present or third-party (skipped)\n";
			echo $c->install_advanced_cache_dropin() ? "advanced-cache.php installed\n" : "advanced-cache.php: present or third-party (skipped)\n";
			PHP
			sudo -u pmpro -H wp --path="${DOCROOT}" eval-file /tmp/pmpro-stack-activate.php --skip-plugins --skip-themes || true
			rm -f /tmp/pmpro-stack-activate.php
		MUACT
		ok "Caching enabled (page cache + Redis object cache)"
	else
		warn "MU plugin not found at ${mu_src}; skipping caching setup."
	fi

	# Final credentials block (printed once).
	echo ""
	echo "$(bold '═══ WordPress Credentials ═══')"
	echo "$(bold 'URL:')          ${url}"
	echo "$(bold 'Admin URL:')    ${url}/wp-admin"
	echo "$(bold 'Admin User:')   ${admin_user}"
	echo "$(bold 'Admin Pass:')   ${admin_pass}"
	echo "$(bold 'Admin Email:')  ${admin_email}"
	echo "$(bold 'DB Name:')      ${db_name}"
	echo "$(bold 'DB User:')      ${db_user}"
	echo "$(bold 'DB Pass:')      ${db_pass}"
	echo "$(bold 'SSH:')          ssh root@${ip}"
	echo ""

	# Write a gitignored creds file (*.env is ignored) so the once-shown
	# password isn't lost. --no-creds-file opts out; --creds-file overrides path.
	if [[ "$no_creds_file" != true ]]; then
		[[ -n "$creds_file" ]] || creds_file="${PWD}/${domain}.env"
		if (umask 077; cat > "$creds_file" <<-CREDS
			# ${domain} — access credentials (KEEP PRIVATE; this file is gitignored)
			WP_URL=${url}
			WP_ADMIN_URL=${url}/wp-admin
			WP_ADMIN_USER=${admin_user}
			WP_ADMIN_PASS=${admin_pass}
			WP_ADMIN_EMAIL=${admin_email}
			DB_NAME=${db_name}
			DB_USER=${db_user}
			DB_PASS=${db_pass}
			DROPLET_IP=${ip}
			SSH_CMD="ssh root@${ip}"
			CREDS
		); then
			ok "Credentials saved to ${creds_file} (chmod 600, gitignored)."
		else
			warn "Could not write creds file to ${creds_file} — copy the block above."
		fi
	fi
	echo "Save the admin password now — it is also shown only once above."
}

cmd_create() {
	local domain="" region="$DEFAULT_REGION" size="$DEFAULT_SIZE"
	local le_email="" ssh_key_id="" ssh_key_file="" direct=false www_mode="auto"
	local smtp_relayhost="" smtp_user="" smtp_pass=""
	local title="$DEFAULT_TITLE" admin_user="$DEFAULT_ADMIN_USER" admin_email="" admin_pass=""
	local creds_file="" no_creds_file=false

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--domain)          domain="$2"; shift 2 ;;
			--region)          region="$2"; shift 2 ;;
			--size)            size="$2"; shift 2 ;;
			--le-email)        le_email="$2"; shift 2 ;;
			--ssh-key-id)      ssh_key_id="$2"; shift 2 ;;
			--ssh-key-file)    ssh_key_file="$2"; shift 2 ;;
			--cf-proxy)        shift ;;  # back-compat no-op: proxied is now the default end state
			--direct)          direct=true; shift ;;
			--www)             www_mode="yes"; shift ;;
			--no-www)          www_mode="no"; shift ;;
			--smtp-relayhost)  smtp_relayhost="$2"; shift 2 ;;
			--smtp-user)       smtp_user="$2"; shift 2 ;;
			--smtp-pass)       smtp_pass="$2"; shift 2 ;;
			--title)           title="$2"; shift 2 ;;
			--admin-user)      admin_user="$2"; shift 2 ;;
			--admin-email)     admin_email="$2"; shift 2 ;;
			--admin-pass)      admin_pass="$2"; shift 2 ;;
			--creds-file)      creds_file="$2"; shift 2 ;;
			--no-creds-file)   no_creds_file=true; shift ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$domain" ]] || die "Missing --domain"
	require_cmds curl jq ssh scp openssl ssh-keygen ansible-playbook tar
	load_env

	domain=$(echo "$domain" | sed -E 's|^https?://||; s|/.*||')

	echo ""
	echo "$(bold '═══════════════════════════════════════════════')"
	echo "$(bold '  pmpro-stack — Provision WordPress + PMPro')"
	echo "$(bold '═══════════════════════════════════════════════')"
	echo ""
	echo "  Domain:  ${domain}"
	echo "  Region:  ${region}"
	echo "  Size:    ${size}"
	echo ""

	# IP-passing temp file for create-droplet.
	PROVISION_IP_FILE=$(mktemp /tmp/pmpro-stack-ip.XXXXXX)
	trap 'rm -f "$PROVISION_IP_FILE"' EXIT

	# Step 1: create the droplet.
	echo "$(bold '── Step 1/4: Create Droplet ──')"
	local cd_args=(--domain "$domain" --region "$region" --size "$size")
	[[ -n "$ssh_key_id" ]]   && cd_args+=(--ssh-key-id "$ssh_key_id")
	[[ -n "$ssh_key_file" ]] && cd_args+=(--ssh-key-file "$ssh_key_file")
	cmd_create_droplet "${cd_args[@]}"

	local ip
	ip=$(cat "$PROVISION_IP_FILE")
	[[ -n "$ip" ]] || die "Could not determine IP address from droplet creation"
	echo ""

	# www override flag passed verbatim to setup-dns + configure so DNS, the cert
	# SAN, and the vhost alias all agree. Empty (auto) lets each resolve it.
	local www_flag=()
	[[ "$www_mode" == yes ]] && www_flag=(--www)
	[[ "$www_mode" == no ]]  && www_flag=(--no-www)

	# Step 2: DNS — always grey-cloud (DNS-only) during provisioning so the
	# certbot HTTP-01 challenge reaches the origin directly. We flip to proxied
	# at the end (unless --direct), once the cert exists.
	echo "$(bold '── Step 2/4: Setup DNS ──')"
	cmd_setup_dns --domain "$domain" --ip "$ip" "${www_flag[@]}"
	echo ""

	# Best-effort wait for DNS to resolve to the new IP (helps certbot HTTP-01).
	if command -v dig >/dev/null 2>&1; then
		info "Waiting for ${domain} to resolve to ${ip} (best-effort, up to 120s)..."
		local waited=0 resolved=""
		while [[ $waited -lt 120 ]]; do
			resolved=$(dig +short "$domain" A 2>/dev/null | head -1 || true)
			if [[ "$resolved" == "$ip" ]]; then
				ok "DNS resolves: ${domain} → ${ip}"
				break
			fi
			sleep 10
			waited=$((waited + 10))
		done
		[[ "$resolved" == "$ip" ]] || warn "DNS did not resolve to ${ip} within 120s; certbot HTTP-01 may fail (re-run 'configure' later)."
	else
		warn "dig not available; skipping DNS-resolves wait."
	fi
	echo ""

	# Step 3: configure (Ansible playbook incl. certbot).
	echo "$(bold '── Step 3/4: Configure Server (Ansible) ──')"
	local cfg_args=(--ip "$ip" --domain "$domain")
	[[ -n "$le_email" ]]       && cfg_args+=(--le-email "$le_email")
	[[ -n "$smtp_relayhost" ]] && cfg_args+=(--smtp-relayhost "$smtp_relayhost")
	[[ -n "$smtp_user" ]]      && cfg_args+=(--smtp-user "$smtp_user")
	[[ -n "$smtp_pass" ]]      && cfg_args+=(--smtp-pass "$smtp_pass")
	# Direct mode isn't fronted by Cloudflare, so the firewall must admit the world.
	[[ "$direct" == true ]]    && cfg_args+=(--open-firewall)
	cfg_args+=("${www_flag[@]}")
	cmd_configure "${cfg_args[@]}"
	echo ""

	# Step 4: install WordPress.
	echo "$(bold '── Step 4/4: Install WordPress ──')"
	local wp_args=(--ip "$ip" --domain "$domain" --title "$title" --admin-user "$admin_user")
	[[ -n "$admin_email" ]] && wp_args+=(--admin-email "$admin_email")
	[[ -n "$admin_pass" ]]  && wp_args+=(--admin-pass "$admin_pass")
	[[ -n "$creds_file" ]]  && wp_args+=(--creds-file "$creds_file")
	[[ "$no_creds_file" == true ]] && wp_args+=(--no-creds-file)
	cmd_install_wp "${wp_args[@]}"
	echo ""

	# Final step: front the site with Cloudflare (flip grey → orange) unless
	# --direct. The UFW role admits 80/443 ONLY from Cloudflare, so a non-proxied
	# record would leave the site unreachable to real visitors. This makes the
	# firewall posture and the DNS proxy state consistent.
	if [[ "$direct" != true ]]; then
		echo "$(bold '── Final: Front with Cloudflare (proxy on) ──')"
		cmd_setup_dns --domain "$domain" --ip "$ip" --cf-proxy "${www_flag[@]}"
		ok "Cloudflare proxy enabled — traffic now flows visitor → Cloudflare → origin."
		echo ""
	else
		warn "Direct mode: site served straight from the origin (no Cloudflare proxy); firewall opened to all on 80/443."
		echo ""
	fi

	echo "$(bold '═══ Provisioning Complete ═══')"
	echo ""
	echo "  Site:   https://${domain}"
	echo "  Admin:  https://${domain}/wp-admin"
	echo "  IP:     ${ip}"
	echo ""
	echo "$(bold 'Next steps:')"
	echo "  1. Visit https://${domain} and finish PMPro setup (levels, pages, payment gateway)."
	echo "  2. If certbot was skipped (no --le-email) or DNS lagged, re-run:"
	echo "       pmpro-stack configure --ip ${ip} --domain ${domain} --le-email you@example.com"
	echo ""
	echo "$(bold 'DNS & caching:')"
	if [[ "$direct" != true ]]; then
		echo "  • The site is proxied through Cloudflare (orange-cloud). Public DNS now"
		echo "    returns Cloudflare edge IPs, not the origin ${ip} — that's expected."
		echo "       dig +short ${domain} @1.1.1.1   # returns Cloudflare IPs (e.g. 104.x / 172.x)"
		echo "       curl -sI https://${domain}      # 200 = reachable end-to-end"
		echo "    The origin firewall admits 80/443 ONLY from Cloudflare, so the site is"
		echo "    reachable solely via the proxy — direct hits to ${ip} are dropped by design."
	else
		echo "  • Direct mode (DNS-only / grey-cloud), so ${ip} is the real origin."
		echo "       dig +short ${domain} @1.1.1.1   # should print ${ip}"
	fi
	echo "  • A new record propagates globally in seconds, but your local resolver may"
	echo "    still cache an older (or negative) result. If it resolves at 1.1.1.1 but"
	echo "    not for you, flush your local DNS cache:"
	echo "       macOS:   sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
	echo "       Linux:   sudo systemd-resolve --flush-caches   (or: resolvectl flush-caches)"
	echo "       Windows: ipconfig /flushdns"
	echo "  • Page cache (Surge) + Redis object cache are ON. After editing content or"
	echo "    config, flush from the WP admin (the 'PMPro Stack' page / Redis plugin)"
	echo "    or you may serve a stale copy."
	echo ""
}

cmd_status() {
	local domain="" ip=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--domain) domain="$2"; shift 2 ;;
			--ip)     ip="$2"; shift 2 ;;
			*) die "Unknown option: $1" ;;
		esac
	done

	[[ -n "$domain" || -n "$ip" ]] || die "Provide --domain <domain> or --ip <ip>"
	require_cmds curl jq ssh
	load_env

	local droplet_id="" status="" created="" found_name=""

	# Look the droplet up by tag, matching on name (when --domain) or public IP.
	info "Looking up droplet..."
	local response
	response=$(do_api GET "/droplets?tag_name=${DEFAULT_TAG}&per_page=200")

	if [[ -n "$domain" ]]; then
		local match
		match=$(echo "$response" | jq -r --arg d "$domain" '
			.droplets[] | select(.name == $d) |
			{id, name, status, ip: (.networks.v4[] | select(.type == "public") | .ip_address), created: .created_at}' 2>/dev/null | head -c 4096)
		if [[ -n "$match" ]]; then
			[[ -z "$ip" ]] && ip=$(echo "$match" | jq -r '.ip')
			droplet_id=$(echo "$match" | jq -r '.id')
			status=$(echo "$match" | jq -r '.status')
			created=$(echo "$match" | jq -r '.created')
			found_name=$(echo "$match" | jq -r '.name')
		fi
	elif [[ -n "$ip" ]]; then
		local match
		match=$(echo "$response" | jq -r --arg ip "$ip" '
			.droplets[] | select((.networks.v4[]? | select(.type == "public") | .ip_address) == $ip) |
			{id, name, status, created: .created_at}' 2>/dev/null | head -c 4096)
		if [[ -n "$match" ]]; then
			droplet_id=$(echo "$match" | jq -r '.id')
			status=$(echo "$match" | jq -r '.status')
			created=$(echo "$match" | jq -r '.created')
			found_name=$(echo "$match" | jq -r '.name')
		fi
	fi

	echo ""
	[[ -n "$domain" ]]     && echo "$(bold 'Domain:')      ${domain}"
	[[ -n "$found_name" ]] && echo "$(bold 'Droplet:')     ${found_name}"
	[[ -n "$ip" ]]         && echo "$(bold 'IP:')          ${ip}"
	if [[ -n "$droplet_id" ]]; then
		echo "$(bold 'Droplet ID:')  ${droplet_id}"
		echo "$(bold 'Status:')      ${status}"
		echo "$(bold 'Created:')     ${created}"
	else
		warn "No pmpro-stack droplet found matching the given ${domain:+domain}${ip:+IP}."
	fi

	# SSH reachability.
	if [[ -n "$ip" ]]; then
		# shellcheck disable=SC2086
		if ssh ${SSH_OPTS} "root@${ip}" "echo ok" >/dev/null 2>&1; then
			ok "SSH accessible"
		else
			warn "SSH not accessible"
		fi
	fi

	# HTTP(S) reachability.
	if [[ -n "$domain" ]]; then
		local http_status
		http_status=$(curl -sS -o /dev/null -w "HTTP %{http_code}" --max-time 15 "https://${domain}" 2>/dev/null || echo "unreachable")
		echo "$(bold 'https://')${domain}: ${http_status}"
	fi
	echo ""
}

# ─── Usage ───────────────────────────────────────────────────────────────────
usage() {
	cat <<-'EOF'
	pmpro-stack — provision a hardened WordPress + Paid Memberships Pro server
	              from scratch on DigitalOcean (stock Ubuntu 24.04 + Ansible).

	Usage: pmpro-stack <command> [options]

	Commands:
	  create           Full flow: create-droplet → setup-dns → configure → install-wp
	  create-droplet   Create a DigitalOcean droplet only (stock Ubuntu 24.04)
	  setup-dns        Upsert apex + www A records in your Cloudflare zone
	  configure        Run the Ansible playbook (../ansible) incl. certbot TLS
	  install-wp       Install WordPress + PMPro on an already-configured server
	  status           Report droplet status + SSH + HTTPS reachability

	Environment:
	  DO_API_TOKEN     DigitalOcean API token (required)
	  CF_API_TOKEN     Cloudflare API token  (required)
	  Both may be exported, or placed (KEY=value) in ~/.pmpro-stack.env.

	create / create-droplet options:
	  --domain <d>             Site domain, e.g. members.example.com (required)
	  --region <r>             DO region            (default: nyc3)
	  --size <s>               DO droplet size      (default: s-2vcpu-4gb)
	  --ssh-key-id <id>        Existing DO SSH key id to inject
	  --ssh-key-file <path>    Public key to import to DO (idempotent by fingerprint)
	                           If neither is given, auto-detects ~/.ssh/id_ed25519.pub
	                           then ~/.ssh/id_rsa.pub.
	  --backups                Enable paid DO automated backups (default: off)

	create / configure options:
	  --le-email <email>       Let's Encrypt contact email (REQUIRED for TLS; omit
	                           to skip certbot and stay HTTP-only)
	  --smtp-relayhost <host>  Outbound SMTP relay host (port 587; BYO)
	  --smtp-user <user>       SMTP username
	  --smtp-pass <pass>       SMTP password
	  --open-firewall          (configure) Admit 80/443 from anywhere instead of
	                           Cloudflare-only. Implied by `create --direct`.

	create options:
	  --direct                 Serve straight from the origin: leave DNS grey-cloud
	                           AND open the firewall to all. Default (no flag) fronts
	                           the site with Cloudflare — grey-cloud during provisioning
	                           (so LE HTTP-01 reaches the origin), then flipped to
	                           proxied at the end so the Cloudflare-only firewall is
	                           consistent and the site is actually reachable.

	create / setup-dns options:
	  --ip <ip>                Server IP (setup-dns/configure/install-wp)
	  --cf-proxy               (setup-dns) Create/patch records proxied (orange-cloud).
	                           On `create` it's a no-op — proxying is the default end state.
	  --www / --no-www         Include / skip the www alias (DNS record, cert SAN,
	                           vhost). Default: no www. Use --www for an apex domain
	                           (example.com) where Cloudflare's *.example.com cert
	                           covers it; not recommended for subdomains (Universal SSL
	                           doesn't cover a multi-level www when proxied).

	create / install-wp options:
	  --title <t>              WordPress site title (default: "Membership Site")
	  --admin-user <u>         WP admin username    (default: admin)
	  --admin-email <e>        WP admin email       (default: admin@<domain>)
	  --admin-pass <p>         WP admin password    (auto-generated, shown once)
	  --creds-file <path>      Where to write the creds .env (default: ./<domain>.env)
	  --no-creds-file          Don't write a credentials file (print to stdout only)

	status options:
	  --domain <d> | --ip <ip>

	Typical:
	  pmpro-stack create --domain members.example.com --le-email you@example.com
	EOF
	exit 0
}

# ─── Main ────────────────────────────────────────────────────────────────────
main() {
	[[ $# -eq 0 ]] && usage

	case "$1" in
		--help|-h|help) usage ;;
	esac

	local cmd="$1"
	shift

	case "$cmd" in
		create)          cmd_create "$@" ;;
		create-droplet)  cmd_create_droplet "$@" ;;
		setup-dns)       cmd_setup_dns "$@" ;;
		configure)       cmd_configure "$@" ;;
		install-wp)      cmd_install_wp "$@" ;;
		status)          cmd_status "$@" ;;
		*) die "Unknown command: $cmd. Run 'pmpro-stack --help' for usage." ;;
	esac
}

main "$@"
